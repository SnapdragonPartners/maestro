# Data-plane image pins.
#
# Both are pinned by ARCH-INDEPENDENT MANIFEST (index) DIGEST, never by tag
# and never by a per-arch image digest — ADR 0026. Development is arm64 and
# CI is amd64; a per-arch digest would break one of them, and a tag is
# mutable. The host resolves the index digest to its own architecture at
# pull time. Both indexes below carry linux/amd64 and linux/arm64.
#
# The tag beside each digest is a human label recording what was pinned; it
# is not what gets pulled. To bump: resolve the new tag with
# `docker buildx imagetools inspect <image>:<tag>`, take the top-level
# Digest, and update both lines together.

# postgres:18 (18.4, Debian trixie). Deliberately NOT -alpine: design D2a
# runs this container as an arbitrary host uid, and the official image's
# arbitrary --user support relies on nss_wrapper when that uid has no
# /etc/passwd entry, which is not present in every variant.
MAESTRO_PG_IMAGE=postgres@sha256:3a82e1f56c8f0f5616a11103ac3d47e632c3938698946a7ad26da0df1334744a

# minio/minio:RELEASE.2025-09-07T16-13-09Z
MAESTRO_MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
