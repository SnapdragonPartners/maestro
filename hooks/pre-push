#!/bin/bash

# Git pre-push hook for Maestro.
#
# Runs the unit tests and COMPILES every integration-tagged test binary
# without running it. It does not run the integration suites: those are
# enforced by CI's required checks (`dataplane-integration` and the
# `dataplane-stack` shards, issue #356), which run them on separate VMs in
# about eight minutes, and by the author before review (`make
# test-integration-v2`, see CLAUDE.md). This hook used to run the whole
# `integration`-tagged tree -- thirty minutes on a laptop, the frozen v1
# suite spending model API tokens among it -- on every push, re-proving
# what CI then proved again. A client-side hook was never the gate: it is
# skipped by `--no-verify` and by a clone that never installed it.
#
# What it still catches, and cheaply: an integration-tagged test file that
# does not compile. `make test` never sees those files, so without this a
# typo in `*_integration_test.go` would surface only in CI.

echo "Running pre-push checks..."

# The output is shown AND kept, under .git/ so it is per-clone and can never
# be committed. The status tested is MAKE's, not tee's: a pipeline's exit
# status is its last command's, and tee succeeds whatever it was handed.
HOOK_LOG_DIR="$(git rev-parse --absolute-git-dir)/maestro-hook-logs"
mkdir -p "$HOOK_LOG_DIR"
# The shell's PID makes the name unique: a timestamp alone has one-second
# resolution, so two runs inside the same second would share a file.
TEST_LOG="$HOOK_LOG_DIR/pre-push-$(date +%Y%m%dT%H%M%S)-$$.log"

{ make check-integration-build && make test; } 2>&1 | tee "$TEST_LOG"
TEST_STATUS=${PIPESTATUS[0]}
ls -1t "$HOOK_LOG_DIR"/pre-push-*.log 2>/dev/null | tail -n +11 | while read -r old; do rm -f "$old"; done
if [ "$TEST_STATUS" -ne 0 ]; then
    echo "❌ Pre-push checks failed! What failed:"
    grep -E '^(--- FAIL|FAIL|panic:|# )|test timed out|cannot |undefined:' "$TEST_LOG" | head -20 | sed 's/^/     /'
    echo "   Full output: $TEST_LOG"
    echo "   Fix the failures. Do NOT bypass this hook with --no-verify."
    exit 1
fi

echo "✅ Pre-push checks passed (unit tests, integration test binaries compile)."
exit 0
